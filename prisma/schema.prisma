generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  fullName  String
  business  String
  phone     String
  email     String
  service   String
  budget    String
  message   String
  createdAt DateTime @default(now())
}